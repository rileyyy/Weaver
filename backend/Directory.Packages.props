<Project>
  <!--
    Central package management: every project takes its package versions from
    here, so one bump keeps related packages in step.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- ASP.NET Core and EF Core ship servicing releases together. -->
    <MicrosoftPlatformVersion>9.0.20</MicrosoftPlatformVersion>
    <IdentityModelVersion>8.22.0</IdentityModelVersion>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core and EF Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="$(MicrosoftPlatformVersion)" />
  </ItemGroup>

  <ItemGroup Label="Other runtime dependencies">
    <PackageVersion Include="Cronos" Version="0.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!--
      Pure managed, so it runs on the Alpine runtime image without native libraries.
      Six Labors Split License: Apache 2.0 terms apply to open-source use like this repo's.
      Held at 3.1: 3.2 and 4.x fail Release builds (CI and the Docker image) without a
      Six Labors license key. See the advisories below before upgrading.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
  </ItemGroup>

  <!--
    ImageSharp 3.1.12's advisories, each fixed only in 3.2.0 / 4.1.2, and none reachable from
    how Weaver uses it (ImageSharpThumbnailGenerator). Remove these when upgrading, and revisit
    them if that class decodes another format or uses another processor.
  -->
  <ItemGroup Label="Audited ImageSharp advisories">
    <!-- TIFF decoder: tiled fax heap overflow, and a BigTIFF loop. TIFF isn't decoded. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- TIFF CCITT T4 and T6 encoders. Only WebP is encoded. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <!-- HistogramEqualization processor. Only AutoOrient and Resize are used. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <!-- ICC CLUT parsing. Profiles are parsed lazily, and the ICC profile is dropped unread. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>
</Project>
