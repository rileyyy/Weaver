# Copy to .env and fill in before running `docker compose up`/`pull` against
# the pre-built images (e.g. on the self-hosted server). Not needed for
# local dev — compose.override.yaml builds from source instead and doesn't
# use BACKEND_IMAGE/FRONTEND_IMAGE, but POSTGRES_PASSWORD is still required
# by compose.yaml's validation even though the override hardcodes a dev
# password over it.

# Published by .github/workflows/docker-publish.yml to
# ghcr.io/<owner>/weaver-backend and weaver-frontend, where <owner> is
# whatever GitHub user/org this repo ends up under. Update OWNER below once
# that's known.
BACKEND_IMAGE=ghcr.io/OWNER/weaver-backend
FRONTEND_IMAGE=ghcr.io/OWNER/weaver-frontend
WEAVER_IMAGE_TAG=latest

# No default in compose.yaml on purpose — a misconfigured deployment should
# fail fast rather than silently run with a weak, well-known password.
POSTGRES_PASSWORD=changeme

# Signs/validates access tokens (see backend/src/Weaver.Infrastructure/Auth).
# Generate a real one with e.g. `openssl rand -base64 48`. Also required
# (but unused) for local dev, same reason as POSTGRES_PASSWORD above —
# compose.override.yaml hardcodes its own dev-only value over this.
JWT_SIGNING_KEY=changeme

# The origin the frontend is actually served from — CORS rejects everything
# else. For local dev this is unused (compose.override.yaml hardcodes
# http://localhost:8082 over it) but still required by compose.yaml's
# validation, same as POSTGRES_PASSWORD above.
CORS_ALLOWED_ORIGIN=https://changeme.example.com
