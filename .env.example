# Copy to .env and fill in every value before running the pre-built images
# (e.g. on the self-hosted server): `docker compose pull && docker compose up -d`.
# The values are left empty on purpose, so a .env copied unchanged fails at
# startup instead of running with publicly known secrets.
#
# Local dev (compose.override.yaml) builds from source and hardcodes its own
# dev values, but compose still validates this file first: any non-empty
# value works there.

# Published by .github/workflows/docker-publish.yml as
# ghcr.io/<owner>/weaver-backend and weaver-frontend (<owner> lowercased).
BACKEND_IMAGE=
FRONTEND_IMAGE=
WEAVER_IMAGE_TAG=latest

# Host name or IP address clients use to reach the server, e.g. weaver.lan
# or 192.168.1.20. Caddy issues the HTTPS certificate for exactly this name
# from its own local CA. Not needed for local dev.
WEAVER_DOMAIN=

# Host ports Caddy listens on. Change only if 80/443 are already taken.
# WEAVER_HTTP_PORT=80
# WEAVER_HTTPS_PORT=443

# Database password. Generate with e.g. `openssl rand -hex 24` (hex keeps it
# safe inside the connection string).
POSTGRES_PASSWORD=

# Signs access tokens; must be at least 32 bytes or the API refuses to start.
# Generate with `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Only needed if a web app on another origin calls the API directly.
# Defaults to https://$WEAVER_DOMAIN.
# CORS_ALLOWED_ORIGIN=
